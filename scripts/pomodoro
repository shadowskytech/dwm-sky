#!/usr/bin/env bash

# pomodoro — simple pomodoro timer with screen lock
#
# Commands:
#   pomodoro start
#   pomodoro stop
#   pomodoro pause
#   pomodoro resume
#   pomodoro status
#   pomodoro toggle
#   pomodoro toggle-pause
#
# Override duration:
#   POMODORO_SEC=60 pomodoro start

set -Eeuo pipefail

readonly DURATION_SEC="${POMODORO_SEC:-1500}"

readonly STATE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/pomodoro-lock"
readonly STATE_FILE="$STATE_DIR/state"
readonly REMAINING_FILE="$STATE_DIR/remaining"
readonly PID_FILE="$STATE_DIR/pid"

readonly STATE_IDLE="idle"
readonly STATE_RUNNING="running"
readonly STATE_PAUSED="paused"

# Export so the nohup worker subprocess inherits the custom duration
export POMODORO_SEC="${POMODORO_SEC:-1500}"

mkdir -p "$STATE_DIR"

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

notify() {
    local msg="$1"

    if command -v notify-send >/dev/null 2>&1; then
        notify-send "Pomodoro" "$msg"
    fi
}

require_command() {
    local cmd="$1"

    if ! command -v "$cmd" >/dev/null 2>&1; then
        echo "pomodoro: required command not found: $cmd" >&2
        exit 1
    fi
}

write_state() {
    echo "$1" > "$STATE_FILE"
}

read_state() {
    cat "$STATE_FILE" 2>/dev/null || echo "$STATE_IDLE"
}

write_remaining() {
    echo "$1" > "$REMAINING_FILE"
}

read_remaining() {
    cat "$REMAINING_FILE" 2>/dev/null || echo "$DURATION_SEC"
}

format_duration() {
    local total="$1"
    printf "%02d:%02d" $(( total / 60 )) $(( total % 60 ))
}

# ---------------------------------------------------------------------------
# Worker PID management
# ---------------------------------------------------------------------------

is_worker_running() {
    [[ -f "$PID_FILE" ]] || return 1

    local pid
    pid="$(<"$PID_FILE")"

    [[ "$pid" =~ ^[0-9]+$ ]] || return 1

    kill -0 "$pid" 2>/dev/null
}

cleanup_worker() {
    rm -f "$PID_FILE"
}

# Kill the worker and wait (with polling) until it's actually gone.
kill_worker_if_any() {
    if ! is_worker_running; then
        rm -f "$PID_FILE"
        return 0
    fi

    local pid
    pid="$(<"$PID_FILE")"

    kill "$pid" 2>/dev/null || true

    # Poll until the process is gone (max ~1 s).
    # wait(1) only works for child processes of the current shell,
    # so we poll kill -0 instead.
    local i=0
    while kill -0 "$pid" 2>/dev/null && (( i++ < 10 )); do
        sleep 0.1
    done

    rm -f "$PID_FILE"
}

# ---------------------------------------------------------------------------
# Background worker loop
# ---------------------------------------------------------------------------

worker() {
    # Remove PID file on any exit so is_worker_running stays accurate.
    trap cleanup_worker EXIT INT TERM

    echo "$$" > "$PID_FILE"

    while true; do
        local state remaining
        state="$(read_state)"
        remaining="$(read_remaining)"

        case "$state" in
            "$STATE_RUNNING")
                if (( remaining <= 0 )); then
                    write_state "$STATE_IDLE"
                    write_remaining "$DURATION_SEC"

                    notify "Pomodoro complete. Locking screen."

                    # cleanup_worker runs via the EXIT trap before exec
                    # replaces this process, so PID_FILE is removed cleanly.
                    exec slock
                fi

                sleep 1
                write_remaining $(( remaining - 1 ))
                ;;

            "$STATE_PAUSED")
                sleep 1
                ;;

            "$STATE_IDLE")
                exit 0
                ;;

            *)
                write_state "$STATE_IDLE"
                ;;
        esac
    done
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

start_timer() {
    require_command slock

    if is_worker_running; then
        echo "pomodoro: timer already running"
        exit 1
    fi

    write_state "$STATE_RUNNING"
    write_remaining "$DURATION_SEC"

    notify "Pomodoro started ($(format_duration "$DURATION_SEC"))."

    # Use BASH_SOURCE[0] instead of $0 so the correct script path is used
    # even when the script is invoked through a symlink or wrapper.
    nohup bash "${BASH_SOURCE[0]}" __worker >/dev/null 2>&1 </dev/null &

    echo "pomodoro: started"
}

stop_timer() {
    write_state "$STATE_IDLE"
    write_remaining "$DURATION_SEC"

    kill_worker_if_any

    notify "Pomodoro stopped."

    echo "pomodoro: stopped"
}

pause_timer() {
    if ! is_worker_running; then
        echo "pomodoro: no active timer"
        exit 1
    fi

    local state
    state="$(read_state)"

    if [[ "$state" == "$STATE_PAUSED" ]]; then
        echo "pomodoro: already paused"
        exit 1
    fi

    write_state "$STATE_PAUSED"

    notify "Pomodoro paused."

    echo "pomodoro: paused"
}

resume_timer() {
    if ! is_worker_running; then
        echo "pomodoro: no active timer"
        exit 1
    fi

    local state
    state="$(read_state)"

    if [[ "$state" != "$STATE_PAUSED" ]]; then
        echo "pomodoro: timer is not paused"
        exit 1
    fi

    write_state "$STATE_RUNNING"

    notify "Pomodoro resumed."

    echo "pomodoro: resumed"
}

toggle_timer() {
    if is_worker_running; then
        stop_timer
    else
        start_timer
    fi
}

toggle_pause_resume() {
    if ! is_worker_running; then
        echo "pomodoro: no active timer"
        exit 1
    fi

    case "$(read_state)" in
        "$STATE_RUNNING")
            pause_timer
            ;;

        "$STATE_PAUSED")
            resume_timer
            ;;

        *)
            echo "pomodoro: invalid timer state"
            exit 1
            ;;
    esac
}

status_timer() {
    local state remaining
    state="$(read_state)"
    remaining="$(read_remaining)"

    printf "pomodoro: %s (%s remaining)\n" \
        "$state" \
        "$(format_duration "$remaining")"
}

# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------

main() {
    local cmd="${1:-start}"

    case "$cmd" in
        start)        start_timer ;;
        stop)         stop_timer ;;
        pause)        pause_timer ;;
        resume)       resume_timer ;;
        status)       status_timer ;;
        toggle)       toggle_timer ;;
        toggle-pause) toggle_pause_resume ;;
        __worker)     worker ;;
        *)
            echo "Usage: pomodoro {start|stop|pause|resume|status|toggle|toggle-pause}"
            exit 1
            ;;
    esac
}

main "$@"
